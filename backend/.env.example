PORT=5050
AWS_REGION=ap-southeast-2
DYNAMODB_TABLE=EcoPaperData
DYNAMODB_GSI=GSI1
DYNAMODB_ACCOUNT_GSI=GSI2
DYNAMODB_APPROVAL_GSI=GSI3
AUTO_PICKUP_THRESHOLD_KG=200
DEFAULT_KG_PER_BAG=20
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=admin@your-domain.org
ADMIN_PASSWORD_HASH=generate-with-bcryptjs
RETURN_RESET_TOKEN=false
SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/<queue>

# Comma-separated browser origins allowed to call the API. Leave empty to allow
# every origin, which is fine locally but should always be set in a deployed
# environment.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Max request body size accepted by the JSON and urlencoded parsers.
JSON_BODY_LIMIT=100kb

# How many proxy hops to trust when resolving the client IP. The deployed path
# is CloudFront -> API Gateway -> Lambda, so 2 is correct there. Only lower this
# if you remove CloudFront.
TRUST_PROXY_HOPS=2

# In-process cache for the admin aggregate endpoints, which would otherwise
# scan the whole DynamoDB table on every request. The cache lives inside each
# warm Lambda container, so this TTL is what bounds how stale an aggregate can
# be. Set CACHE_ENABLED=false to bypass it entirely while debugging.
CACHE_ENABLED=true
CACHE_AGGREGATE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=500

# Rate limits. Counters are per Lambda container, so these are a brake rather
# than an exact global ceiling; API Gateway throttling is the hard backstop.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=30
